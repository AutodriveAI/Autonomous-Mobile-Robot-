# ROS 2 build products; regenerated with colcon.
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# STM32CubeIDE build products; regenerated by CubeIDE.
**/Debug/
**/Release/

# STM32CubeIDE/Eclipse local workspace metadata.
# Keep project source/config files, but ignore machine-specific index/settings
# that change with local toolchain paths and workspace state.
diff_drive_stm32controller/.metadata/
diff_drive_stm32controller/MyProject/.settings/language.settings.xml

# Python caches and test output.
**/__pycache__/
*.py[cod]
.pytest_cache/

# Local editor and operating-system files.
.vscode/*
!.vscode/settings.json
.DS_Store
