<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_description</name>
  <version>0.1.0</version>
  <description>
    ROS 2 visual description package for the differential-drive robot exported
    from Onshape. It installs the URDF and STL meshes and launches robot_state_publisher.
  </description>

  <maintainer email="you@example.com">Nilkontha Das</maintainer>
  <license>MIT</license>

  <!-- ament_python installs this package's data files into the ROS 2 share directory. -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Nodes started by launch/display.launch.py. -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
