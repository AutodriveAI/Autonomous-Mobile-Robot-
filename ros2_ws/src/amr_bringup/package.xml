<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_bringup</name>
  <version>0.1.0</version>
  <description>Top-level bringup launch files for the AMR simulation and real robot.</description>
  <maintainer email="you@example.com">Nilkontha Das</maintainer>
  <license>MIT</license>

  <exec_depend>amr_description</exec_depend>
  <exec_depend>amr_driver</exec_depend>
  <exec_depend>amr_localisation</exec_depend>
  <exec_depend>amr_navigation</exec_depend>
  <exec_depend>amr_sensors</exec_depend>
  <exec_depend>amr_slam</exec_depend>
  <exec_depend>amr_teleop</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
