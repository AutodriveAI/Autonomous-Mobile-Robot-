<?xml version='1.0' encoding='utf-8'?>
<robot name="amr_cad_description_simplified" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    This Xacro file keeps two ideas separate:

    1. Visual geometry:
       The detailed OBJ meshes exported from Onshape. These make the robot look correct in RViz.

    2. Physics geometry:
       Simple collision and inertial shapes. These are intentionally rough because Gazebo/physics
       runs much better with boxes, cylinders, and spheres than with detailed CAD meshes.

    The mass values below are first-pass placeholders. Later, measure the real robot mass and wheel
    mass, then update these values to make Gazebo behave closer to the physical robot.
  -->

  <xacro:property name="body_collision_radius" value="0.10" />
  <xacro:property name="body_collision_height" value="0.21" />
  <xacro:property name="wheel_collision_radius" value="0.035" />
  <xacro:property name="wheel_collision_width" value="0.04" />
  <xacro:property name="antenna_collision_radius" value="0.02" />
  <xacro:property name="antenna_collision_height" value="0.21" />

  <!-- Inertia of a rectangular box centered on the link frame. -->
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${mass}" />
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}" />
    </inertial>
  </xacro:macro>

  <!-- Inertia of a wheel-like cylinder whose rotation axle is along the link's Y axis. -->
  <xacro:macro name="wheel_inertial" params="mass radius width">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${mass}" />
      <inertia
        ixx="${mass * (3.0*radius*radius + width*width) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * radius*radius / 2.0}" iyz="0"
        izz="${mass * (3.0*radius*radius + width*width) / 12.0}" />
    </inertial>
  </xacro:macro>

  <!-- Inertia of a small ball caster approximation. -->
  <xacro:macro name="sphere_inertial" params="mass radius">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${mass}" />
      <inertia
        ixx="${2.0 * mass * radius*radius / 5.0}" ixy="0" ixz="0"
        iyy="${2.0 * mass * radius*radius / 5.0}" iyz="0"
        izz="${2.0 * mass * radius*radius / 5.0}" />
    </inertial>
  </xacro:macro>

  <!-- Inertia of a vertical cylinder whose cylinder axis is along the link's Z axis. -->
  <xacro:macro name="vertical_cylinder_inertial" params="mass radius height xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0" />
      <mass value="${mass}" />
      <inertia
        ixx="${mass * (3.0*radius*radius + height*height) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (3.0*radius*radius + height*height) / 12.0}" iyz="0"
        izz="${mass * radius*radius / 2.0}" />
    </inertial>
  </xacro:macro>

  <link name="base_link" />
  <link name="chassis_link">
    <xacro:vertical_cylinder_inertial mass="1.5" radius="${body_collision_radius}" height="${body_collision_height}" xyz="0.025 0 0.0906" />
    <collision>
      <origin xyz="0.025 0 0.0906" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${body_collision_radius}" length="${body_collision_height}" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.02288 0 -0.01425" rpy="1.57079633 -0 1.57079633" />
      <geometry>
        <mesh filename="package://amr_cad_description/meshes/bottom_layer_1.obj" scale="1 1 1" />
      </geometry>
