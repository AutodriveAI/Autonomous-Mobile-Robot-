<?xml version='1.0' encoding='utf-8'?>
<robot name="amr_sim_description" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Lightweight Gazebo model.

    This file intentionally avoids the detailed OBJ CAD meshes. Gazebo Classic can become very
    slow while converting/loading high-triangle visual meshes. For simulation startup and physics
    testing, primitive visuals plus primitive collisions are much faster and easier to debug.
  -->

  <xacro:property name="body_radius" value="0.10" />
  <xacro:property name="body_height" value="0.21" />
  <xacro:property name="body_x" value="0.025" />
  <xacro:property name="body_z" value="0.0906" />

  <xacro:property name="wheel_radius" value="0.035" />
  <xacro:property name="wheel_width" value="0.04" />
  <xacro:property name="wheel_y" value="0.0875" />

  <xacro:property name="caster_radius" value="0.012" />
  <xacro:property name="antenna_radius" value="0.02" />
  <xacro:property name="antenna_height" value="0.21" />

  <material name="body_gray">
    <color rgba="0.75 0.75 0.72 1.0" />
  </material>
  <material name="wheel_yellow">
    <color rgba="1.0 0.85 0.0 1.0" />
  </material>
  <material name="rubber_dark">
    <color rgba="0.05 0.05 0.05 1.0" />
  </material>
  <material name="antenna_gray">
    <color rgba="0.55 0.55 0.55 1.0" />
  </material>
  <material name="sensor_blue">
    <color rgba="0.25 0.55 0.9 1.0" />
  </material>

  <xacro:macro name="vertical_cylinder_inertial" params="mass radius height xyz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0" />
      <mass value="${mass}" />
      <inertia
        ixx="${mass * (3.0*radius*radius + height*height) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (3.0*radius*radius + height*height) / 12.0}" iyz="0"
        izz="${mass * radius*radius / 2.0}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertial" params="mass radius width">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${mass}" />
      <inertia
        ixx="${mass * (3.0*radius*radius + width*width) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * radius*radius / 2.0}" iyz="0"
        izz="${mass * (3.0*radius*radius + width*width) / 12.0}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="mass radius">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${mass}" />
      <inertia
        ixx="${2.0 * mass * radius*radius / 5.0}" ixy="0" ixz="0"
        iyy="${2.0 * mass * radius*radius / 5.0}" iyz="0"
        izz="${2.0 * mass * radius*radius / 5.0}" />
    </inertial>
  </xacro:macro>

  <link name="base_link" />

  <link name="chassis_link">
    <xacro:vertical_cylinder_inertial mass="1.5" radius="${body_radius}" height="${body_height}" xyz="${body_x} 0 ${body_z}" />
    <visual>
      <origin xyz="${body_x} 0 ${body_z}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${body_radius}" length="${body_height}" />
      </geometry>
      <material name="body_gray" />
    </visual>
    <collision>
      <origin xyz="${body_x} 0 ${body_z}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${body_radius}" length="${body_height}" />
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <xacro:wheel_inertial mass="0.18" radius="${wheel_radius}" width="${wheel_width}" />
    <visual>
      <origin xyz="0 0 0" rpy="1.57079633 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <material name="wheel_yellow" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079633 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
    </collision>
  </link>

  <link name="right_wheel_link">
    <xacro:wheel_inertial mass="0.18" radius="${wheel_radius}" width="${wheel_width}" />
    <visual>
      <origin xyz="0 0 0" rpy="1.57079633 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <material name="wheel_yellow" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079633 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
    </collision>
  </link>

  <link name="right_caster_link">
    <xacro:sphere_inertial mass="0.05" radius="${caster_radius}" />
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
      <material name="rubber_dark" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.0045" rpy="0 0 0" />
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
    </collision>
  </link>

  <link name="left_caster_link">
    <xacro:sphere_inertial mass="0.05" radius="${caster_radius}" />
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
      <material name="rubber_dark" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.0045" rpy="0 0 0" />
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
    </collision>
  </link>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.17" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.038" length="0.04" />
      </geometry>
      <material name="rubber_dark" />
    </visual>
  </link>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.02" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.035 0.025 0.008" />
      </geometry>
      <material name="sensor_blue" />
    </visual>
  </link>

  <link name="antenna_link">
    <visual>
      <origin xyz="0 0.0336 0.075" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${antenna_radius}" length="${antenna_height}" />
      </geometry>
      <material name="antenna_gray" />
    </visual>
    <visual>
      <origin xyz="0 -0.0336 0.075" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${antenna_radius}" length="${antenna_height}" />
      </geometry>
      <material name="antenna_gray" />
    </visual>
    <collision name="left_antenna_collision">
      <origin xyz="0 0.0336 0.075" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${antenna_radius}" length="${antenna_height}" />
      </geometry>
    </collision>
    <collision name="right_antenna_collision">
      <origin xyz="0 -0.0336 0.075" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${antenna_radius}" length="${antenna_height}" />
      </geometry>
    </collision>
  </link>

  <joint name="base_link_to_chassis" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="chassis_link" />
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 ${wheel_y} 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.03" />
    <parent link="base_link" />
    <child link="left_wheel_link" />
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 ${-wheel_y} 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.03" />
    <parent link="base_link" />
    <child link="right_wheel_link" />
  </joint>

  <joint name="base_link_to_right_caster" type="fixed">
    <origin xyz="0.0852169927 -0.000901843 -0.0183911429" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_caster_link" />
  </joint>

  <joint name="base_link_to_left_caster" type="fixed">
    <origin xyz="-0.0397830073 -0.000901843 -0.0183911429" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="left_caster_link" />
  </joint>

  <joint name="base_link_to_lidar" type="fixed">
    <origin xyz="0.0126386 0.0002054 0.17618784" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lidar_link" />
  </joint>

  <joint name="base_link_to_imu" type="fixed">
    <origin xyz="0.0305993 -1.84695904e-13 0.11675" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="imu_link" />
  </joint>

  <joint name="base_link_to_antenna" type="fixed">
    <origin xyz="-0.0282686178 -0.000126309031 0.213981697" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="antenna_link" />
  </joint>
</robot>
