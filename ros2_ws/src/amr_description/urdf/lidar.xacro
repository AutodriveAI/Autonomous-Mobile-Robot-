<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    RPLidar visual and scan-frame description.

    This file owns the lidar frame and visual CAD meshes. The current mesh
    filenames still come from the earlier Onshape A1 export, so treat them as a
    visual placeholder until we export/import a dedicated C1 mesh. The active
    physical launch and Gazebo scan model are configured for RPLidar C1.
  -->

  <xacro:macro name="amr_lidar">
  <link name="lidar_link">
    <xacro:box_inertial mass="0.17" x="0.075" y="0.075" z="0.04" />
    <visual>
      <origin xyz="0.03 -0.1 -0.08500004" rpy="1.57079633 4.8965888e-12 -3.14158898" />
