<sdf version="1.7">
  <world name="simple_home">
    <!--
      Lightweight household-style test world for SLAM and Nav2.

      Design goals:
        - no external model:// dependencies
        - no animated actors
        - no heavy meshes
        - closed outer boundary for clean SLAM
        - simple room/corridor structure for localization and planning tests

      Units are meters. The robot spawns near (0, 0), so the central hallway is
      intentionally open.
    -->

    <gravity>0 0 -9.8</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.72 0.76 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.2 -1.0</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>9.0 7.0 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>9.0 7.0 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.58 0.58 0.55 1</ambient>
            <diffuse>0.58 0.58 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer boundary walls: 9 m x 7 m home footprint. -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.0 0.12 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>9.0 0.12 1.0</size></box></geometry><material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.0 0.12 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>9.0 0.12 1.0</size></box></geometry><material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>4.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 7.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 7.0 1.0</size></box></geometry><material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-4.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 7.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 7.0 1.0</size></box></geometry><material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.82 0.82 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Interior walls with door gaps. -->
    <model name="left_room_wall_top">
      <static>true</static>
      <pose>-1.6 2.15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 2.7 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 2.7 1.0</size></box></geometry><material><ambient>0.75 0.78 0.80 1</ambient><diffuse>0.75 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="left_room_wall_bottom">
      <static>true</static>
      <pose>-1.6 -2.15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 2.7 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 2.7 1.0</size></box></geometry><material><ambient>0.75 0.78 0.80 1</ambient><diffuse>0.75 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="right_room_wall_top">
      <static>true</static>
      <pose>1.7 2.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 2.9 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 2.9 1.0</size></box></geometry><material><ambient>0.75 0.78 0.80 1</ambient><diffuse>0.75 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="right_room_wall_bottom">
      <static>true</static>
      <pose>1.7 -2.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 2.9 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 2.9 1.0</size></box></geometry><material><ambient>0.75 0.78 0.80 1</ambient><diffuse>0.75 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="top_room_divider_left">
      <static>true</static>
      <pose>-3.05 1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.9 0.12 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.9 0.12 1.0</size></box></geometry><material><ambient>0.75 0.78 0.80 1</ambient><diffuse>0.75 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="top_room_divider_right">
      <static>true</static>
      <pose>3.10 1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.8 0.12 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.8 0.12 1.0</size></box></geometry><material><ambient>0.75 0.78 0.80 1</ambient><diffuse>0.75 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="bottom_room_divider_left">
      <static>true</static>
      <pose>-3.0 -1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.12 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.12 1.0</size></box></geometry><material><ambient>0.75 0.78 0.80 1</ambient><diffuse>0.75 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="bottom_room_divider_right">
      <static>true</static>
      <pose>3.10 -1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.8 0.12 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.8 0.12 1.0</size></box></geometry><material><ambient>0.75 0.78 0.80 1</ambient><diffuse>0.75 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Light primitive furniture/obstacles. -->
    <model name="sofa">
      <static>true</static>
      <pose>-3.3 2.35 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.3 0.55 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.3 0.55 0.5</size></box></geometry><material><ambient>0.22 0.35 0.60 1</ambient><diffuse>0.22 0.35 0.60 1</diffuse></material></visual>
      </link>
    </model>

    <model name="dining_table">
      <static>true</static>
      <pose>3.0 2.35 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.1 0.8 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.1 0.8 0.7</size></box></geometry><material><ambient>0.45 0.25 0.12 1</ambient><diffuse>0.45 0.25 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <model name="bed">
      <static>true</static>
      <pose>-3.2 -2.35 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.7 1.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.7 1.0 0.5</size></box></geometry><material><ambient>0.55 0.35 0.45 1</ambient><diffuse>0.55 0.35 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <model name="kitchen_counter">
      <static>true</static>
      <pose>3.35 -2.75 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 0.45 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 0.45 0.9</size></box></geometry><material><ambient>0.50 0.50 0.48 1</ambient><diffuse>0.50 0.50 0.48 1</diffuse></material></visual>
      </link>
    </model>

    <model name="center_box">
      <static>true</static>
      <pose>0.0 1.85 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.55 0.55 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.55 0.5</size></box></geometry><material><ambient>0.75 0.45 0.15 1</ambient><diffuse>0.75 0.45 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <model name="small_round_obstacle">
      <static>true</static>
      <pose>0.35 -1.9 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.20 0.55 0.30 1</ambient><diffuse>0.20 0.55 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
