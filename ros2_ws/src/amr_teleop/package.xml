<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_teleop</name>
  <version>0.1.0</version>
  <description>Keyboard and joystick teleoperation for the autonomous mobile robot.</description>
  <maintainer email="you@example.com">Nilkontha Das</maintainer>
  <license>MIT</license>

  <!--
    This package is intentionally only a project-specific entry point for the
    standard ROS 2 keyboard teleop node. That node publishes geometry_msgs/Twist
    commands on /cmd_vel and owns all terminal keyboard handling.
  -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
